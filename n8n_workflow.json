    {
      "parameters": {
        "method": "POST",
        "url": "https://api.deepseek.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer sk-a575e39ba4654351b797637c2e784699"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"deepseek-chat\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an expert content editor. Your task is to process a Telegram post:\\n1. Classify the post into one of these categories: IT, CREATIVITY, BUSINESS, DIPLOMACY, GENERAL, MARKETING.\\n2. Clean the text from generic ads, channel cross-promotions, and sponsor credits.\\n3. IMPORTANT: You MUST preserve and keep any registration links, event links, webinar registration URLs, and app signup links mentioned in the text. Format them as plain text URLs (e.g. https://example.com) or standard HTML links: <a href=\\\"https://example.com\\\">Регистрация</a>. DO NOT use markdown format like [text](url).\\n4. Generate 2-4 highly relevant hashtags in Russian representing the post theme.\\n5. Respond ONLY with a valid JSON object containing these keys: 'category' (one of the 6 strings above), 'cleaned_text' (the processed text), 'hashtags' (string with space-separated hashtags, e.g. '#маркетинг #дизайн').\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.body.text || \"\") }}\n    }\n  ]\n}"
      },
      "id": "8327d78d-194c-474c-a13a-73d8ab87201c",
      "name": "DeepSeek AI Classifier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        600,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Получаем ответ от DeepSeek\nconst responseContent = JSON.parse($json.choices[0].message.content);\n\n// Извлекаем нужные поля\nconst category = responseContent.category || 'GENERAL';\nconst cleanedText = responseContent.cleaned_text || '';\nconst hashtags = responseContent.hashtags || '';\n\n// Маппинг категорий в message_thread_id (топики/ячейки в супергруппе Telegram)\nconst threadMap = {\n  \"GENERAL\": 1,\n  \"CREATIVITY\": 5,\n  \"IT\": 2,\n  \"DIPLOMACY\": 7,\n  \"BUSINESS\": 6,\n  \"MARKETING\": 8\n};\n\nconst messageThreadId = threadMap[category] || threadMap[\"GENERAL\"];\n\n// Собираем финальный текст для публикации\nlet finalText = cleanedText;\nif (hashtags) {\n  finalText += '\\n\\n' + hashtags;\n}\n\n// Ограничение Telegram на описание медиафайлов составляет 1024 символа.\n// Если текст длиннее, то отправляем медиафайл пустым, а текст отправляем следом отдельным сообщением.\nconst isLongText = finalText.length > 1024;\nconst mediaCaption = isLongText ? '' : finalText;\n\nreturn {\n  json: {\n    original_text: $('Webhook Trigger').item.json.body.text,\n    channel_name: $('Webhook Trigger').item.json.body.channel_name,\n    media_type: $('Webhook Trigger').item.json.body.media_type || null,\n    category: category,\n    message_thread_id: messageThreadId,\n    final_text: finalText,\n    media_caption: mediaCaption,\n    should_send_split_text: isLongText\n  },\n  binary: $('Webhook Trigger').item.binary || {}\n};"
      },
      "id": "76495dbb-2d4e-4f1e-b816-56c68b7593c6",
      "name": "Parse & Map Thread ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
