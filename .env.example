# ====================================================================
# Telegram API Credentials (my.telegram.org)
# ====================================================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_NAME=skillhub_session

# ====================================================================
# n8n Integration Settings
# ====================================================================
# URL Webhook в вашем n8n, куда юзербот будет отправлять новые посты
N8N_WEBHOOK_URL=http://localhost:5678/webhook/your-webhook-uuid

# ====================================================================
# Имя вашего аккаунта (для команд в Избранное)
# ====================================================================
# Вы можете отправлять команды в Saved Messages.
# Укажите ваш username без @ (например, zoldos), чтобы только вы могли управлять.
ADMIN_USERNAME=zoldos
